# Shared monorepo ignore rules. Documentation remains tracked intentionally.

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Rust
target/
**/*.rs.bk
.cargo-home/

# Local infra / data
clickhouse_data/
hyperdx_data/

# Env / secrets
.env
.env.local
*.local

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# Tooling
.mcp.json
