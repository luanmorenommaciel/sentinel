{
  "version": "1.0.0",
  "producer": "sentinel/otel-collector",
  "consumer": "clickstack",
  "description": "Schema of OpenTelemetry signals ingested into ClickHouse by Sentinel Pod 2 (Go OTel Collector). Consumers must reference this contract before querying the sentinel database.",
  "updated": "2026-06-07",
  "database": "sentinel",
  "input_contract": "contract/schema/schema_output.json",
  "tables": {
    "otel_spans": {
      "description": "OpenTelemetry trace spans emitted by OTelGen (Pod 1)",
      "engine": "MergeTree",
      "partition_by": "toYYYYMM(toDateTime(ingested_at))",
      "order_by": ["service_name", "start_unix_nano", "trace_id"],
      "columns": [
        {"name": "trace_id",            "type": "String",                    "nullable": false, "description": "32 lower-case hex chars"},
        {"name": "span_id",             "type": "String",                    "nullable": false, "description": "16 lower-case hex chars"},
        {"name": "parent_span_id",      "type": "Nullable(String)",          "nullable": true,  "description": "NULL for root spans"},
        {"name": "service_name",        "type": "LowCardinality(String)",    "nullable": false},
        {"name": "name",                "type": "String",                    "nullable": false, "description": "Span operation name"},
        {"name": "start_unix_nano",     "type": "Int64",                     "nullable": false, "description": "Start timestamp in nanoseconds"},
        {"name": "end_unix_nano",       "type": "Int64",                     "nullable": false, "description": "End timestamp in nanoseconds"},
        {"name": "status_code",         "type": "LowCardinality(String)",    "nullable": false, "description": "OK or ERROR"},
        {"name": "attributes",          "type": "Map(String, String)",       "nullable": false},
        {"name": "resource_attributes", "type": "Map(String, String)",       "nullable": false},
        {"name": "contract_version",    "type": "LowCardinality(String)",    "nullable": false},
        {"name": "ingested_at",         "type": "DateTime64(9)",             "nullable": false}
      ]
    },
    "otel_logs": {
      "description": "OpenTelemetry log records emitted by OTelGen (Pod 1)",
      "engine": "MergeTree",
      "partition_by": "toYYYYMM(toDateTime(ingested_at))",
      "order_by": ["service_name", "time_unix_nano"],
      "columns": [
        {"name": "time_unix_nano",      "type": "Int64",                     "nullable": false, "description": "Log timestamp in nanoseconds"},
        {"name": "service_name",        "type": "LowCardinality(String)",    "nullable": false},
        {"name": "severity_text",       "type": "LowCardinality(String)",    "nullable": false, "description": "INFO, WARN, ERROR, DEBUG"},
        {"name": "severity_number",     "type": "Int32",                     "nullable": false, "description": "OTel numeric severity (9=INFO)"},
        {"name": "body",                "type": "String",                    "nullable": false, "description": "Log message body"},
        {"name": "trace_id",            "type": "Nullable(String)",          "nullable": true,  "description": "Trace correlation ID; NULL if not in trace context"},
        {"name": "span_id",             "type": "Nullable(String)",          "nullable": true,  "description": "Span correlation ID; NULL if not in span context"},
        {"name": "attributes",          "type": "Map(String, String)",       "nullable": false},
        {"name": "resource_attributes", "type": "Map(String, String)",       "nullable": false},
        {"name": "contract_version",    "type": "LowCardinality(String)",    "nullable": false},
        {"name": "ingested_at",         "type": "DateTime64(9)",             "nullable": false}
      ]
    },
    "otel_metrics": {
      "description": "OpenTelemetry metrics (gauge and sum) emitted by OTelGen (Pod 1)",
      "engine": "MergeTree",
      "partition_by": "toYYYYMM(toDateTime(ingested_at))",
      "order_by": ["service_name", "name", "time_unix_nano"],
      "columns": [
        {"name": "time_unix_nano",      "type": "Int64",                     "nullable": false, "description": "Metric timestamp in nanoseconds"},
        {"name": "service_name",        "type": "LowCardinality(String)",    "nullable": false},
        {"name": "name",                "type": "String",                    "nullable": false, "description": "Metric instrument name"},
        {"name": "type",                "type": "LowCardinality(String)",    "nullable": false, "description": "gauge or sum"},
        {"name": "value",               "type": "Float64",                   "nullable": false},
        {"name": "attributes",          "type": "Map(String, String)",       "nullable": false},
        {"name": "resource_attributes", "type": "Map(String, String)",       "nullable": false},
        {"name": "contract_version",    "type": "LowCardinality(String)",    "nullable": false},
        {"name": "ingested_at",         "type": "DateTime64(9)",             "nullable": false}
      ]
    }
  },
  "examples": {
    "otel_spans": [
      {
        "trace_id": "0822e8f36c031199972a846916419f82",
        "span_id": "17fc695a07a0ca6e",
        "parent_span_id": null,
        "service_name": "pubsub-ingestion-topic",
        "name": "messaging.operation",
        "start_unix_nano": 1700000000000000000,
        "end_unix_nano": 1700000000030032131,
        "status_code": "OK",
        "attributes": {"component.name": "messaging.ingestion_topic", "component.type": "messaging"},
        "resource_attributes": {"cloud.provider": "gcp", "cloud.region": "us-central1", "cloud.platform": "gcp_pubsub", "sentinel.synthetic": "true", "sentinel.scenario": "baseline", "sentinel.run_id": "golden-fixed-run", "service.name": "pubsub-ingestion-topic"},
        "contract_version": "1.0.0"
      }
    ],
    "otel_logs": [
      {
        "time_unix_nano": 1700000000000000000,
        "service_name": "pubsub-ingestion-topic",
        "severity_text": "INFO",
        "severity_number": 9,
        "body": "Request completed successfully.",
        "trace_id": "0822e8f36c031199972a846916419f82",
        "span_id": "17fc695a07a0ca6e",
        "attributes": {"component.name": "messaging.ingestion_topic"},
        "resource_attributes": {"cloud.provider": "gcp", "sentinel.scenario": "baseline"},
        "contract_version": "1.0.0"
      }
    ],
    "otel_metrics": [
      {
        "time_unix_nano": 1700000000000000000,
        "service_name": "pubsub-ingestion-topic",
        "name": "operation.latency_ms",
        "type": "gauge",
        "value": 30.032,
        "attributes": {"component.name": "messaging.ingestion_topic", "component.type": "messaging"},
        "resource_attributes": {"cloud.provider": "gcp", "sentinel.scenario": "baseline"},
        "contract_version": "1.0.0"
      },
      {
        "time_unix_nano": 1700000000000000000,
        "service_name": "pubsub-ingestion-topic",
        "name": "operation.request_count",
        "type": "sum",
        "value": 1.0,
        "attributes": {"component.name": "messaging.ingestion_topic", "status": "ok"},
        "resource_attributes": {"cloud.provider": "gcp", "sentinel.scenario": "baseline"},
        "contract_version": "1.0.0"
      }
    ]
  },
  "known_metric_names": [
    "operation.latency_ms",
    "operation.request_count",
    "operation.error_count",
    "pubsub.googleapis.com/topic/send_message_operation_count",
    "pubsub.googleapis.com/subscription/oldest_unacked_message_age",
    "kubernetes.io/container/cpu/core_usage_time",
    "kubernetes.io/container/memory/used_bytes",
    "dataproc.googleapis.com/cluster/yarn/allocated_memory_percentage",
    "dataproc.googleapis.com/cluster/yarn/pending_memory_percentage",
    "storage.googleapis.com/api/request_count"
  ],
  "known_services": [
    "pubsub-ingestion-topic",
    "gcs-raw-bucket",
    "gcs-processed-bucket",
    "k8s-api-gateway",
    "dataproc-spark-streaming",
    "dataproc-spark-batch"
  ]
}
