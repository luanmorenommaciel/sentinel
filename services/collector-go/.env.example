# OTel Collector — environment variables
# Copy to .env and fill in real values (never commit .env with credentials)

# gRPC OTLP receiver port (default: 4317)
GRPC_PORT=4317

# HTTP health/ready/metrics port (default: 8080)
HTTP_PORT=8080

# ClickHouse DSN — native TCP protocol
# Format: clickhouse://user:password@host:port/database
# Production: inject via Secret Manager, Vault, or Kubernetes secret
CLICKHOUSE_DSN=clickhouse://otelgen:otelgen_secret@localhost:9000/sentinel

# Batch insert tuning
BATCH_SIZE=100
FLUSH_INTERVAL_MS=500

# Log format: json (production) or text (development)
LOG_FORMAT=json

# Contract version validation — warn if incoming telemetry has a different version
CONTRACT_VERSION=1.0.0

# Rate limiting — max OTLP requests per second (0 = disabled)
RATE_LIMIT_RPS=0

# TLS — leave empty for insecure (default, docker-compose local)
# Set both to enable TLS on the gRPC port
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
