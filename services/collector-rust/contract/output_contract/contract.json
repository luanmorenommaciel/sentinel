{
  "version": "1.0.0",
  "producer": "sentinel/rust-otel-collector",
  "consumer": "clickstack",
  "description": "Schema of OpenTelemetry signals ingested into ClickHouse by Sentinel Pod 2 (Rust OTel Collector). Consumers must reference this contract before querying the sentinel database. Resource-attribute keys guaranteed by the upstream contract are hoisted into first-class columns for index-usable filtering.",
  "updated": "2026-06-16",
  "database": "sentinel",
  "input_contract": "contract/schema/schema_output.json",
  "tables": {
    "otel_logs": {
      "description": "OpenTelemetry log records emitted by OTelGen (Pod 1)",
      "engine": "MergeTree",
      "partition_by": "toDate(Timestamp)",
      "order_by": ["ServiceName", "Timestamp", "TraceId"],
      "ttl": "toDate(Timestamp) + INTERVAL 30 DAY",
      "columns": [
        {"name": "Timestamp",          "type": "DateTime64(9, 'UTC')",    "nullable": false, "codec": "Delta, ZSTD(1)", "description": "Log timestamp (time_unix_nano cast to DateTime64)"},
        {"name": "ServiceName",        "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"service.name\"]"},
        {"name": "SentinelScenario",   "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.scenario\"]"},
        {"name": "SentinelRunId",      "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.run_id\"]"},
        {"name": "CloudProvider",      "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"cloud.provider\"]"},
        {"name": "SentinelSynthetic",  "type": "UInt8",                   "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.synthetic\"] cast to 1/0"},
        {"name": "SeverityText",       "type": "LowCardinality(String)",  "nullable": false, "description": "Human-readable severity (INFO, WARN, ERROR, DEBUG)"},
        {"name": "SeverityNumber",     "type": "Int32",                   "nullable": false, "codec": "Delta, ZSTD(1)", "description": "OTel numeric severity (9=INFO, 13=WARN, 17=ERROR)"},
        {"name": "Body",               "type": "String",                  "nullable": false, "codec": "ZSTD(1)", "description": "Log message body"},
        {"name": "TraceId",            "type": "String",                  "nullable": false, "description": "32-char lowercase hex; empty string if absent"},
        {"name": "SpanId",             "type": "String",                  "nullable": false, "description": "16-char lowercase hex; empty string if absent"},
        {"name": "ContractVersion",    "type": "LowCardinality(String)",  "nullable": false, "description": "Version of the input contract that produced this record"},
        {"name": "LogAttributes",      "type": "Map(String, String)",     "nullable": false, "description": "Log-level attributes (component.name, etc.)"},
        {"name": "ResourceAttributes", "type": "Map(String, String)",     "nullable": false, "description": "Remaining resource attributes not hoisted above"}
      ]
    },
    "otel_traces": {
      "description": "OpenTelemetry trace spans emitted by OTelGen (Pod 1)",
      "engine": "MergeTree",
      "partition_by": "toDate(Timestamp)",
      "order_by": ["ServiceName", "Timestamp", "TraceId"],
      "ttl": "toDate(Timestamp) + INTERVAL 30 DAY",
      "columns": [
        {"name": "Timestamp",          "type": "DateTime64(9, 'UTC')",    "nullable": false, "codec": "Delta, ZSTD(1)", "description": "Start timestamp (start_unix_nano cast to DateTime64); drives partitioning and time-range scans"},
        {"name": "TraceId",            "type": "String",                  "nullable": false, "description": "32-char lowercase hex"},
        {"name": "SpanId",             "type": "String",                  "nullable": false, "description": "16-char lowercase hex"},
        {"name": "ParentSpanId",       "type": "String",                  "nullable": false, "description": "16-char lowercase hex; empty string for root spans"},
        {"name": "SpanName",           "type": "LowCardinality(String)",  "nullable": false, "description": "Span operation name"},
        {"name": "ServiceName",        "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"service.name\"]"},
        {"name": "SentinelScenario",   "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.scenario\"]"},
        {"name": "SentinelRunId",      "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.run_id\"]"},
        {"name": "CloudProvider",      "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"cloud.provider\"]"},
        {"name": "SentinelSynthetic",  "type": "UInt8",                   "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.synthetic\"] cast to 1/0"},
        {"name": "Duration",           "type": "Int64",                   "nullable": false, "codec": "Delta, ZSTD(1)", "description": "end_unix_nano - start_unix_nano in nanoseconds; divide by 1e6 for milliseconds"},
        {"name": "StatusCode",         "type": "LowCardinality(String)",  "nullable": false, "description": "Span status: OK or ERROR"},
        {"name": "ContractVersion",    "type": "LowCardinality(String)",  "nullable": false, "description": "Version of the input contract that produced this record"},
        {"name": "SpanAttributes",     "type": "Map(String, String)",     "nullable": false, "description": "Span-level attributes (component.name, component.type, etc.)"},
        {"name": "ResourceAttributes", "type": "Map(String, String)",     "nullable": false, "description": "Remaining resource attributes not hoisted above"}
      ]
    },
    "otel_metrics": {
      "description": "OpenTelemetry metrics (gauge and sum) emitted by OTelGen (Pod 1)",
      "engine": "MergeTree",
      "partition_by": "toDate(Timestamp)",
      "order_by": ["ServiceName", "MetricName", "Timestamp"],
      "ttl": "toDate(Timestamp) + INTERVAL 90 DAY",
      "columns": [
        {"name": "Timestamp",          "type": "DateTime64(9, 'UTC')",    "nullable": false, "codec": "Delta, ZSTD(1)", "description": "Metric timestamp (time_unix_nano cast to DateTime64)"},
        {"name": "MetricName",         "type": "LowCardinality(String)",  "nullable": false, "description": "Metric instrument name"},
        {"name": "MetricType",         "type": "LowCardinality(String)",  "nullable": false, "description": "Metric kind: gauge (instantaneous) or sum (cumulative)"},
        {"name": "Value",              "type": "Float64",                 "nullable": false, "codec": "ZSTD(1)", "description": "Numeric metric value"},
        {"name": "ServiceName",        "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"service.name\"]"},
        {"name": "SentinelScenario",   "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.scenario\"]"},
        {"name": "SentinelRunId",      "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.run_id\"]"},
        {"name": "CloudProvider",      "type": "LowCardinality(String)",  "nullable": false, "description": "Hoisted from resource_attributes[\"cloud.provider\"]"},
        {"name": "SentinelSynthetic",  "type": "UInt8",                   "nullable": false, "description": "Hoisted from resource_attributes[\"sentinel.synthetic\"] cast to 1/0"},
        {"name": "ContractVersion",    "type": "LowCardinality(String)",  "nullable": false, "description": "Version of the input contract that produced this record"},
        {"name": "Attributes",         "type": "Map(String, String)",     "nullable": false, "description": "Metric-level attributes (component.name, component.type, status, unit, etc.)"},
        {"name": "ResourceAttributes", "type": "Map(String, String)",     "nullable": false, "description": "Remaining resource attributes not hoisted above"}
      ]
    },
    "otel_metrics_1m": {
      "description": "1-minute pre-aggregated rollup for z-score anomaly detection. Populated by the otel_metrics_1m_mv materialized view. Readers MUST re-aggregate with the declared combinator function (sum/min/max) per column when parts are unmerged.",
      "engine": "AggregatingMergeTree",
      "partition_by": "toDate(window_start)",
      "order_by": ["ServiceName", "MetricName", "SentinelScenario", "window_start"],
      "ttl": "toDate(window_start) + INTERVAL 90 DAY",
      "materialized_view": "otel_metrics_1m_mv",
      "columns": [
        {"name": "window_start",     "type": "DateTime",                                       "nullable": false, "description": "Start of the 1-minute aggregation window"},
        {"name": "ServiceName",      "type": "LowCardinality(String)",                         "nullable": false},
        {"name": "MetricName",       "type": "LowCardinality(String)",                         "nullable": false},
        {"name": "SentinelScenario", "type": "LowCardinality(String)",                         "nullable": false, "description": "Enables separate baselines per scenario"},
        {"name": "count",            "type": "SimpleAggregateFunction(sum, UInt64)",            "nullable": false, "description": "Number of data points in the window"},
        {"name": "sum_val",          "type": "SimpleAggregateFunction(sum, Float64)",           "nullable": false, "description": "Sum of values; use sum_val/count for mean"},
        {"name": "sum_sq",           "type": "SimpleAggregateFunction(sum, Float64)",           "nullable": false, "description": "Sum of squared values; use sqrt(sum_sq/n - (sum/n)^2) for stddev"},
        {"name": "min_val",          "type": "SimpleAggregateFunction(min, Float64)",           "nullable": false, "description": "Minimum value in the window"},
        {"name": "max_val",          "type": "SimpleAggregateFunction(max, Float64)",           "nullable": false, "description": "Maximum value in the window"}
      ]
    }
  },
  "examples": {
    "otel_traces": [
      {
        "Timestamp": "2023-11-14T22:13:20.000000000Z",
        "TraceId": "0822e8f36c031199972a846916419f82",
        "SpanId": "17fc695a07a0ca6e",
        "ParentSpanId": "",
        "SpanName": "messaging.operation",
        "ServiceName": "pubsub-ingestion-topic",
        "SentinelScenario": "baseline",
        "SentinelRunId": "golden-fixed-run",
        "CloudProvider": "gcp",
        "SentinelSynthetic": 1,
        "Duration": 30032131,
        "StatusCode": "OK",
        "ContractVersion": "1.0.0",
        "SpanAttributes": {"component.name": "messaging.ingestion_topic", "component.type": "messaging"},
        "ResourceAttributes": {"cloud.region": "us-central1", "cloud.platform": "gcp_pubsub"}
      }
    ],
    "otel_logs": [
      {
        "Timestamp": "2023-11-14T22:13:20.000000000Z",
        "ServiceName": "pubsub-ingestion-topic",
        "SentinelScenario": "baseline",
        "SentinelRunId": "golden-fixed-run",
        "CloudProvider": "gcp",
        "SentinelSynthetic": 1,
        "SeverityText": "INFO",
        "SeverityNumber": 9,
        "Body": "Request completed successfully.",
        "TraceId": "0822e8f36c031199972a846916419f82",
        "SpanId": "17fc695a07a0ca6e",
        "ContractVersion": "1.0.0",
        "LogAttributes": {"component.name": "messaging.ingestion_topic"},
        "ResourceAttributes": {}
      }
    ],
    "otel_metrics": [
      {
        "Timestamp": "2023-11-14T22:13:20.000000000Z",
        "MetricName": "operation.latency_ms",
        "MetricType": "gauge",
        "Value": 30.032,
        "ServiceName": "pubsub-ingestion-topic",
        "SentinelScenario": "baseline",
        "SentinelRunId": "golden-fixed-run",
        "CloudProvider": "gcp",
        "SentinelSynthetic": 1,
        "ContractVersion": "1.0.0",
        "Attributes": {"component.name": "messaging.ingestion_topic", "component.type": "messaging"},
        "ResourceAttributes": {}
      },
      {
        "Timestamp": "2023-11-14T22:13:20.000000000Z",
        "MetricName": "operation.request_count",
        "MetricType": "sum",
        "Value": 1.0,
        "ServiceName": "pubsub-ingestion-topic",
        "SentinelScenario": "baseline",
        "SentinelRunId": "golden-fixed-run",
        "CloudProvider": "gcp",
        "SentinelSynthetic": 1,
        "ContractVersion": "1.0.0",
        "Attributes": {"component.name": "messaging.ingestion_topic", "status": "ok"},
        "ResourceAttributes": {}
      }
    ]
  },
  "known_metric_names": [
    "operation.latency_ms",
    "operation.request_count",
    "operation.error_count",
    "pubsub.googleapis.com/topic/send_message_operation_count",
    "pubsub.googleapis.com/subscription/oldest_unacked_message_age",
    "kubernetes.io/container/cpu/core_usage_time",
    "kubernetes.io/container/memory/used_bytes",
    "dataproc.googleapis.com/cluster/yarn/allocated_memory_percentage",
    "dataproc.googleapis.com/cluster/yarn/pending_memory_percentage",
    "storage.googleapis.com/api/request_count"
  ],
  "known_services": [
    "pubsub-ingestion-topic",
    "gcs-raw-bucket",
    "gcs-processed-bucket",
    "k8s-api-gateway",
    "dataproc-spark-streaming",
    "dataproc-spark-batch"
  ]
}
